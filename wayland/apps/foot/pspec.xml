<?xml version="1.0" ?>
<!DOCTYPE PISI SYSTEM "https://www.pisilinux.org/projeler/pisi/pisi-spec.dtd">
<PISI>
    <Source>
        <Name>foot</Name>
        <Homepage>https://codeberg.org/dnkl/foot</Homepage>
        <Packager>
            <Name>Erkan IŞIK</Name>
            <Email>erkanisik@pisilinux.org</Email>
        </Packager>
        <License>MIT</License>
        <IsA>app:gui</IsA>
        <Summary>A fast, lightweight and minimalistic Wayland terminal emulator</Summary>
        <Description>foot is a fast, lightweight and minimalistic Wayland terminal emulator that features UTF-8 support, font fallback, and daemon mode.</Description>
        <Archive sha1sum="68ff560b1f7e4828564db199f966b4b6a1130c79" type="targz">
            https://codeberg.org/dnkl/foot/archive/1.28.0.tar.gz
            <!-- https://codeberg.org/dnkl/foot -->
        </Archive>
       <BuildDependencies>
            <Dependency>meson</Dependency>
            <Dependency>ninja</Dependency>
            <Dependency>cmake</Dependency>
            <Dependency>pkgconfig</Dependency>
            <Dependency>wayland-devel</Dependency>
            <Dependency>wayland-protocols-devel</Dependency>
            <Dependency>wayland-cursor</Dependency> <!-- veya wayland-cursor -->

            <Dependency>tllist-devel</Dependency>
            <Dependency>utf8proc-devel</Dependency>
            <Dependency>fcft-devel</Dependency> <!-- fcft-devel yerine fcft yazın -->
            <Dependency>libxkbcommon-devel</Dependency>
            <Dependency>pixman-devel</Dependency>
            <Dependency>harfbuzz-devel</Dependency>
            <Dependency>fontconfig-devel</Dependency>
            <Dependency>freetype-devel</Dependency>

            <Dependency>scdoc</Dependency>
        </BuildDependencies>
    </Source>

    <Package>
        <Name>foot</Name>
        <RuntimeDependencies>
            <Dependency>wayland</Dependency>
            <Dependency>fcft</Dependency>
            <Dependency>libxkbcommon</Dependency>
            <Dependency>pixman</Dependency>
            <Dependency>fontconfig</Dependency>
            <Dependency>freetype</Dependency>
        </RuntimeDependencies>
        <Files>
            <Path fileType="executable">/usr/bin</Path>
            <Path fileType="doc">/usr/share/doc</Path>
            <Path fileType="man">/usr/share/man</Path>
            <Path fileType="data">/usr/share/foot</Path>
            <Path fileType="data">/usr/share/applications</Path>
            <Path fileType="data">/usr/share/icons</Path>
            <Path fileType="data">/usr/share/zsh</Path>
            <Path fileType="data">/usr/share/bash-completion</Path>
            <Path fileType="data">/usr/share/fish</Path>
            <Path fileType="config">/etc/xdg/foot</Path>
            <Path fileType="data">/usr/share/terminfo</Path>
        </Files>
    </Package>

    <History>
        <Update release="1">
            <Date>2026-10-03</Date>
            <Version>1.28.0</Version>
            <Comment>First release for Pisi Linux.</Comment>
            <Name>Erkan IŞIK</Name>
            <Email>erkanisik@pisilinux.org</Email>
        </Update>
    </History>
</PISI>