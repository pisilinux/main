        <Archive sha1sum="14811b84ed1fee55459ae97f1f409fbc84525094" type="targz">
            https://codeberg.org/dnkl/fuzzel/archive/1.15.0.tar.gz
        </Archive>
        <BuildDependencies>
            <Dependency>meson</Dependency>
            <Dependency>ninja</Dependency>
            <Dependency>gcc</Dependency>
            <Dependency>pkgconfig</Dependency>
            <Dependency>wayland-devel</Dependency>
            <Dependency>wayland-protocols-devel</Dependency>
            <Dependency>wayland-cursor</Dependency>
            <Dependency>pixman-devel</Dependency>
            <Dependency>fcft-devel</Dependency>
            <Dependency>libpng-devel</Dependency>
            <Dependency>cairo-devel</Dependency>
            <Dependency>fcft-devel</Dependency>
            <Dependency>libxkbcommon-devel</Dependency>
            <Dependency>tesseract-devel</Dependency>
            <Dependency>scdoc</Dependency>
        </BuildDependencies>
    </Source>

    <Package>
        <Name>fuzzel</Name>
        <RuntimeDependencies>
            <Dependency>wayland</Dependency>
            <Dependency>pixman</Dependency>
            <Dependency>fcft</Dependency>
            <Dependency>libpng</Dependency>
            <Dependency>cairo</Dependency>
        </RuntimeDependencies>
        <Files>
            <Path fileType="executable">/usr/bin</Path>
            <Path fileType="doc">/usr/share/doc</Path>
            <Path fileType="man">/usr/share/man</Path>
            <Path fileType="config">/etc/xdg/fuzzel</Path>
            <Path fileType="data">/usr/share/zsh</Path>
            <Path fileType="data">/usr/share/fish</Path>
        </Files>
    </Package>

