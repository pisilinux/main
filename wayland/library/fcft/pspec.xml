<?xml version="1.0" ?>
<!DOCTYPE PISI SYSTEM "https://www.pisilinux.org/projeler/pisi/pisi-spec.dtd">
<PISI>
    <Source>
        <Name>fcft</Name>
        <Homepage>https://codeberg.org/dnkl/fcft</Homepage>
        <Packager>
            <Name>Erkan IŞIK</Name>
            <Email>erkanisik@pisilinux.org</Email>
        </Packager>
        <License>MIT</License>
        <IsA>library</IsA>
        <Summary>Simple library for font loading and glyph rendering</Summary>
        <Description>fcft is a small, high-performance library for font loading and glyph rendering using FreeType, fontconfig and pixman.</Description>
        <Archive sha1sum="beff080fcd5356cbac83e3dfea90840d2ab9c98f" type="targz">https://codeberg.org/dnkl/fcft/archive/3.3.3.tar.gz</Archive>
        <BuildDependencies>
            <Dependency>meson</Dependency>
            <Dependency>ninja</Dependency>
            <Dependency>gcc</Dependency>
            <Dependency>cmake</Dependency>
            <Dependency>pkgconfig</Dependency>
            <Dependency>freetype-devel</Dependency>
            <Dependency>fontconfig-devel</Dependency>
            <Dependency>pixman-devel</Dependency>
            <Dependency>tllist-devel</Dependency>
            <Dependency>harfbuzz-devel</Dependency>
            <Dependency>utf8proc-devel</Dependency>
            <Dependency>tesseract-devel</Dependency>
            <Dependency>scdoc</Dependency>
        </BuildDependencies>
    </Source>

    <Package>
        <Name>fcft</Name>
        <RuntimeDependencies>
            <Dependency>freetype</Dependency>
            <Dependency>fontconfig</Dependency>
            <Dependency>pixman</Dependency>
            <Dependency>harfbuzz</Dependency>
            <Dependency>utf8proc</Dependency>
        </RuntimeDependencies>
        <Files>
            <Path fileType="library">/usr/lib</Path>
            <Path fileType="doc">/usr/share/doc</Path>
            <Path fileType="man">/usr/share/man</Path>
        </Files>
    </Package>

    <Package>
        <Name>fcft-devel</Name>
        <Summary>Development files for fcft</Summary>
        <RuntimeDependencies>
            <Dependency release="current">fcft</Dependency>
            <Dependency>freetype-devel</Dependency>
            <Dependency>fontconfig-devel</Dependency>
            <Dependency>pixman-devel</Dependency>
        </RuntimeDependencies>
        <Files>
            <Path fileType="header">/usr/include</Path>
            <Path fileType="data">/usr/lib/pkgconfig</Path>
        </Files>
    </Package>

    <History>
        <Update release="1">
            <Date>2026-10-02</Date>
            <Version>3.3.3</Version>
            <Comment>First release for Pisi Linux.</Comment>
            <Name>Erkan IŞIK</Name>
            <Email>erkanisik@pisilinux.org</Email>
        </Update>
    </History>
</PISI>
