+						} else {
+							odm_set_bb_reg(dm, 0xccc, 0x000007ff, 0x0);
+							odm_set_bb_reg(dm, 0xcd4, 0x000007ff, 0x200);
+							TX0IQKOK = false;
+							cal_retry++;
+							if (cal_retry == 10)
+								break;
