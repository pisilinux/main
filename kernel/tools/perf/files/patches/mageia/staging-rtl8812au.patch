+		case ODM_RTL8721D:
+			phy_lc_calibrate_8721d(dm);
+			break;
+#endif
+#if (RTL8723B_SUPPORT == 1)
+		case ODM_RTL8723B:
+			phy_lc_calibrate_8723b(dm);
+			break;
+#endif
+#if (RTL8723D_SUPPORT == 1)
+		case ODM_RTL8723D:
+			phy_lc_calibrate_8723d(dm);
+			break;
+#endif
+#if (RTL8812A_SUPPORT == 1)
+		case ODM_RTL8812:
+			phy_lc_calibrate_8812a(dm);
+			break;
+#endif
+#if (RTL8821A_SUPPORT == 1)
