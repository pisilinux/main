+	{125892541, 158489319, 199526232, 251188643, 316227766, 398107171,
+	 501187234, 630957345}, /* @U(32,0) */
+	{794328235, 1000000000, 1258925412, 1584893192, 1995262315,
+	 2511886432U, 3162277660U, 3981071706U} }; /* @U(32,0) */
