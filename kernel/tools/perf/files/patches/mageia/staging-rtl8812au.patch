+	boolean		is_main
+)
+{
+	/* HAL_DATA_TYPE	*hal_data = GET_HAL_DATA(adapter); */
+
+#ifdef DISABLE_BB_RF
+	return;
+#endif
+
+	{
+		/* For 88C 1T1R */
+		_phy_set_rf_path_switch_8812a(dm, is_main, false);
+	}
