+						}
+
+						if (delay_count < 20) {							/* If 20ms No Result, then cal_retry++ */
+							/* ============TXIQK Check============== */
+							TX_fail = odm_get_bb_reg(dm, 0xd00, BIT(12));
+
+							if (~TX_fail) {
+								odm_write_4byte(dm, 0xcb8, 0x02000000);
