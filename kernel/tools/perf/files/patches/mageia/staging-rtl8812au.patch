+				for (ii = i + 1; ii < rx_average; ii++) {
+					dx = (RX_X0[1][i] >> 21) - (RX_X0[1][ii] >> 21);
+					if (dx < 4 && dx > -4) {
+						dy = (RX_Y0[1][i] >> 21) - (RX_Y0[1][ii] >> 21);
+						if (dy < 4 && dy > -4) {
+							RX_X = ((RX_X0[1][i] >> 21) + (RX_X0[1][ii] >> 21)) / 2;
+							RX_Y = ((RX_Y0[1][i] >> 21) + (RX_Y0[1][ii] >> 21)) / 2;
