+			else if (e_rf_path == RF_PATH_B)
+				READ_AND_CONFIG_MP(8814b, _radiob);
+			else if (e_rf_path == RF_PATH_C)
+				READ_AND_CONFIG_MP(8814b, _radioc);
+			else if (e_rf_path == RF_PATH_D)
+				READ_AND_CONFIG_MP(8814b, _radiod);
