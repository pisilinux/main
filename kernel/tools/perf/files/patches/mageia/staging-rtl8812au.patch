+	PHYDM_DONT_IGNORE_EDCCA		= 1
+};
+
+enum phydm_adaptivity_mode {
+	PHYDM_ADAPT_MSG			= 0,
+	PHYDM_ADAPT_DEBUG		= 1,
+	PHYDM_ADAPT_RESUME		= 2,
+	PHYDM_EDCCA_TH_PAUSE		= 3,
+	PHYDM_EDCCA_TH_RESUME		= 4
+};
+
+struct phydm_adaptivity_struct {
+	s8			th_l2h_ini_backup;
+	s8			th_edcca_hl_diff_backup;
+	s8			igi_base;
+	s8			h2l_lb;
