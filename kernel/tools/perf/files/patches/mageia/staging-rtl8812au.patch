+s32
+_sign(
+	u32 number
+)
+{
+	if ((number & BIT(10)) == BIT10) {/* Negative */
+		number &= (~0xFFFFFC00);         /* [9:0] */
+		number = ~number;
+		number &= (~0xFFFFFC00);         /* [9:0] */
+		number += 1;
+		number &= (~0xFFFFF800);		  /* [10:0] */
+		return -1 * number;
+	} else   /* Positive */
+		return (s32)number;
+}
