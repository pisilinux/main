+void
+_dpk_rf_backup_path_b(
+	struct dm_struct	*dm,
+	u32				*backup_reg_addr,
+	enum rf_path	rf_path,
+	u32				*backup_reg_data,
+	u32		        number
+)
+{
+	u32 i;
+
+	for (i = 0; i < number; i++)
+		backup_reg_data[i] = odm_get_rf_reg(dm, (enum rf_path)rf_path, backup_reg_addr[i], RFREGOFFSETMASK);
