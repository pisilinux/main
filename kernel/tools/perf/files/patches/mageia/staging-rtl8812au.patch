+	u8	write_fw = 0;
+	u32 fwdl_start_time;
+	PHAL_DATA_TYPE	pHalData = GET_HAL_DATA(Adapter);	
+	
+	u8				*pFwImageFileName;
+	u8				*pucMappedFile = NULL;
+	PRT_FIRMWARE_8814	pFirmware = NULL;
+	u8				*pFwHdr = NULL;
