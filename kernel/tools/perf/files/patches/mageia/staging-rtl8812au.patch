+rtl8812_Efuse_PgPacketRead(IN	PADAPTER	pAdapter,
+			   IN	u8			offset,
+			   IN	u8			*data,
+			   IN	BOOLEAN		bPseudoTest)
+{
+	int	ret = 0;
+
+	ret = hal_EfusePgPacketRead_8812A(pAdapter, offset, data, bPseudoTest);
+
+	return ret;
+}
