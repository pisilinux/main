+		for (i = 0; i < MAX_CHANNEL_NUM; i++) {
+			if (regsty->excl_chs[i] == 0)
+				break;
+			_RTW_PRINT_SEL(sel, "%u ", regsty->excl_chs[i]);
+		}
+		_RTW_PRINT_SEL(sel, "\n");
+	}
+
+	dump_chset(sel, rfctl->channel_set);
+}
