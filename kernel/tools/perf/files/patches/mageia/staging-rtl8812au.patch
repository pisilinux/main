+	if (dm->support_ic_type & (ODM_RTL8192F))
+		phydm_config_cck_rx_path(dm, BB_PATH_AB);
+	else
+		phydm_config_cck_rx_path(dm, BB_PATH_A);
+
+	phydm_cck_new_agc_chk(dm);
+	phydm_cck_lna_bit_num_chk(dm);
+	phydm_get_cck_rssi_table_from_reg(dm);
+}
