+							odm_write_4byte(dm, 0xcb8, 0x04000000);
+							TX_Y0[cal] = odm_get_bb_reg(dm, R_0xd00, 0x07ff0000) << 21;
+							TX0IQKOK = true;
+#if 0
+							odm_write_4byte(dm, 0xcb8, 0x01000000);
