+void
+_dpk_mac_bb_restore_path_b(
+	struct dm_struct	*dm,
+	u32		*backup_reg_addr,
+	u32		*backup_reg_data,
+	u32		number
+)
+{
+	u32 i;
+
+	for (i = 0; i < number; i++)
+		odm_write_4byte(dm, backup_reg_addr[i], backup_reg_data[i]);
+}
