+		u1Tmp = rtw_read8(pdapter, 0x790);
+		u1Tmp = (u1Tmp & 0xb0) | 0x05 ;
+		rtw_write8(pdapter, 0x790, u1Tmp);
+		/* PTA parameter */
+		/* pBtCoexist->fBtcWrite1Byte(pBtCoexist, 0x6cc, 0x0); */
