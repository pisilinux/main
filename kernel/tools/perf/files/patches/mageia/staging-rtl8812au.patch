+	}
+#endif
+
+#if (RTL8814B_SUPPORT)
+	if (dm->support_ic_type & ODM_RTL8814B) {
+		if (rate < 0x4)
+			txagc_tmp = config_phydm_read_txagc_8814b(dm, path,
+								  rate,
+								  PDM_CCK);
+		else
+			txagc_tmp = config_phydm_read_txagc_8814b(dm, path,
+								  rate,
+								  PDM_OFDM);
