+u8
+GetTxBufferRsvdPageNum8812(_adapter *Adapter, bool bWoWLANBoundary)
+{
+	HAL_DATA_TYPE	*pHalData = GET_HAL_DATA(Adapter);
+	u8	RsvdPageNum = 0;
