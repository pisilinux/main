+	if (Adapter->registrypriv.rf_config == RF_1T2R && IS_HARDWARE_TYPE_8812AU(Adapter))
+		phy_set_bb_reg(Adapter, rTxPath_Jaguar, bMaskLWord, 0x1111);
+#endif
