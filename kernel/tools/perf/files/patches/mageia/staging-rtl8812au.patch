+		phy_load_tx_power_by_rate(adapter, chk_file);
+
+#if CONFIG_TXPWR_LIMIT
+	if (phy_is_tx_power_limit_needed(adapter))
+		phy_load_tx_power_limit(adapter, chk_file);
+#endif
+}
