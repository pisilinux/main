index 000000000..512bb7f30
--- /dev/null
+++ b/drivers/staging/rtl8812au/include/rtw_wapi.h
@@ -0,0 +1,230 @@
+/******************************************************************************
+ *
+ * Copyright(c) 2016 - 2017 Realtek Corporation.
+ *
