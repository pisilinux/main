+int
+PHY_RF6052_Config_8814A(
+	IN	PADAPTER		Adapter)
+{
+	HAL_DATA_TYPE		*pHalData = GET_HAL_DATA(Adapter);
+	int					rtStatus = _SUCCESS;
+
+	// Initialize general global value
+	pHalData->NumTotalRFPath = 4;
+
+	//
+	// Config BB and RF
+	//
+	rtStatus = phy_RF6052_Config_ParaFile_8814A(Adapter);
+
+	return rtStatus;
+
+}
+
