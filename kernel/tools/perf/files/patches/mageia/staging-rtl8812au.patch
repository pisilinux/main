+					odm_write_4byte(dm, 0xc8c, 0x28160d00);
+
+				odm_write_4byte(dm, 0xcb8, 0x00100000);/* cb8[20] 將 SI/PI 使用權切給 iqk_dpk module */
+
+				cal_retry = 0;
+				while (1) {
+					/* one shot */
