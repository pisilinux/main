+	// e.For USB: SYS_FUNC_EN 0x02[7:0] = 0x16
+	rtw_write8(Adapter, REG_SYS_FUNC_EN_8814A, 0x16);
+	// f. For USB: SYS_FUNC_EN 0x02[7:0] = 0x17
+	rtw_write8(Adapter, REG_SYS_FUNC_EN_8814A, 0x17);
