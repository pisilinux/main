+static u8	Get_VHT_ENI(
+	u32		IOTAction,
+	u32		WirelessMode,
+	u32		ratr_bitmap
+	)
+{
+	u8	Ret = 0;
+
+	if(WirelessMode == WIRELESS_11_24AC)
+	{
+		if(ratr_bitmap & 0xfff00000)	// Mix , 2SS
+			Ret = 3;
+		else 					// Mix, 1SS
+			Ret = 2;
+	}
+	else if(WirelessMode == WIRELESS_11_5AC)
+	{
+		Ret = 1;					// VHT
+	}
+
+	return (Ret << 4);
+}
