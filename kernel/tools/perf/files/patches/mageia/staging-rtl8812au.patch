+			 /*Resp Tx by Txinfo*/
+			odm_set_bb_reg(dm, R_0x6d8, 0xc0, 2);
+		}
+	}
+	p_div->default_tx_path = path;
+
+	PHYDM_DBG(dm, DBG_PATH_DIV, "path=%s\n",
+		  (path == BB_PATH_A) ? "A" : "B");
+}
