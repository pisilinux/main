new file mode 100644
index 000000000..d9f5652f9
--- /dev/null
+++ b/drivers/staging/rtl8812au/core/rtw_mem.c
@@ -0,0 +1,128 @@
+/******************************************************************************
+ *
+ * Copyright(c) 2016 - 2017 Realtek Corporation.
