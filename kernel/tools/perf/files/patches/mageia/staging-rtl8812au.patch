+	}
+	break;
+	default:
+		break;
+	}
+
+#if (DM_ODM_SUPPORT_TYPE & ODM_AP)
+	if (!TX0IQKOK)
+		panic_printk("[IQK] please check TXIQK\n");
+	if (!RX0IQKOK)
+		panic_printk("[IQK] please check RXIQK\n");
+#endif
+}
