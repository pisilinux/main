+
+	#if (RTL8814A_SUPPORT == 1)
+	case ODM_RTL8814A:
+		rx_pow = phydm_cck_rssi_8814a(dm, lna_idx, vga_idx);
+		break;
+	#endif
+
+	default:
+		break;
+	}
+
+	return rx_pow;
+}
