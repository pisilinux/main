+#elif (DM_ODM_SUPPORT_TYPE == ODM_CE)
+
+void odm_sw_antdiv_workitem_callback(void *context)
+{
+	void *
+		adapter = (void *)context;
+	HAL_DATA_TYPE
+	*hal_data = GET_HAL_DATA(((PADAPTER)adapter));
+
+#if 0
