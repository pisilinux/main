+u8 rtl8814_set_rssi_cmd(_adapter*padapter, u8 *param)
+{
+	u8	res=_SUCCESS;
+	HAL_DATA_TYPE	*pHalData = GET_HAL_DATA(padapter);
+
+	*((u32*) param ) = cpu_to_le32( *((u32*) param ) );
+
+	FillH2CCmd_8814(padapter, H2C_RSSI_SETTING, 4, param);
+
+	return res;
+}
