
Hook up to module buildsystem.

Signed-off-by: Thomas Backlund <tmb@mageia.org>

---
 drivers/staging/Kconfig  |    2 ++
 drivers/staging/Makefile |    1 +
 2 files changed, 3 insertions(+)

diff -Nurp linux-6.13/drivers/staging/Kconfig linux-6.13.rtl/drivers/staging/Kconfig
--- linux-6.13/drivers/staging/Kconfig	2024-12-02 21:47:12.880119562 +0100 
+++ linux-6.13.rtl/drivers/staging/Kconfig	2024-12-02 21:49:31.634191404 +0100
@@ -26,6 +26,8 @@ if STAGING
 
 source "drivers/staging/rtl8723bs/Kconfig"
 
+source "drivers/staging/rtl8812au/Kconfig"
+
 source "drivers/staging/octeon/Kconfig"
 
 source "drivers/staging/iio/Kconfig"
diff -Nurp linux-6.13/drivers/staging/Makefile linux-6.13.rtl/drivers/staging/Makefile
--- linux-6.13/drivers/staging/Makefile	2024-12-02 21:47:12.880119562 +0100
+++ linux-6.13.rtl/drivers/staging/Makefile	2024-12-02 21:48:43.329467961 +0100
@@ -3,6 +3,7 @@
 
 obj-y				+= media/
 obj-$(CONFIG_RTL8723BS)		+= rtl8723bs/
+obj-$(CONFIG_RTL8812AU)		+= rtl8812au/
 obj-$(CONFIG_OCTEON_ETHERNET)	+= octeon/
 obj-$(CONFIG_VME_BUS)		+= vme_user/
 obj-$(CONFIG_IIO)		+= iio/
