<?xml version="1.0" ?>
<!DOCTYPE PISI SYSTEM "https://pisilinux.org/projeler/pisi/pisi-spec.dtd">
<PISI>
    <Source>
        <Name>wordpress-desktop</Name>
        <Homepage>https://desktop.wordpress.com/</Homepage>
        <Packager>
            <Name>Erkan IŞIK</Name>
            <Email>erkanisik@pisilinux.org</Email>
        </Packager>
        <License>GPLv2</License>
        <Icon>wordpress-desktop</Icon>
        <IsA>app:gui</IsA>
        <Summary>Wordpress Desktop a Control Panel for all your Wordpress Sites</Summary>
        <Description>A desktop app that gives WordPress a permanent home in your dock.You'll need a WordPress.com login.</Description>
        <BuildDependencies>
            <Dependency>nodejs</Dependency>
            <Dependency>python3-devel</Dependency>
            <Dependency>make</Dependency>
            <Dependency>gcc</Dependency>
            <Dependency>binutils</Dependency>
            <Dependency>pkgconfig</Dependency>
            <Dependency>ca-certificates</Dependency>
        </BuildDependencies>
        <!-- wp-desktop deposu sadece dagitim icin tutuluyor (v8.2.4 tarball'i
             yalnizca README.md icerir); derlenebilir kaynak wp-calypso'dadir. -->
        <Archive sha1sum="ab30b4d8ecdb493e1d0e0311cfa41bdfe5ef516b" type="targz">https://github.com/Automattic/wp-calypso/archive/refs/tags/desktop-v8.2.4.tar.gz</Archive>
    </Source>

    <Package>
        <Name>wordpress-desktop</Name>
        <RuntimeDependencies>
            <Dependency>libgcc</Dependency>
            <Dependency>alsa-lib</Dependency>
            <Dependency>nss</Dependency>
            <Dependency>gtk3</Dependency>
            <Dependency>mesa</Dependency>
            <Dependency>libnotify</Dependency>
            <Dependency>libgpg-error</Dependency>
            <Dependency>libsecret</Dependency>
            <Dependency>libXScrnSaver</Dependency>
            <Dependency>libxkbfile</Dependency>
            <Dependency>libXtst</Dependency>
        </RuntimeDependencies>
        <Files>
            <Path fileType="data">/usr/share/wpcom</Path>
            <Path fileType="app">/usr/share/applications</Path>
            <Path fileType="icon">/usr/share/pixmaps</Path>
            <Path fileType="doc">/usr/share/doc</Path>
        </Files>
        <AdditionalFiles>
            <AdditionalFile owner="root" group="root" permission="0644" target="/usr/share/applications/wpcom.desktop">wpcom.desktop</AdditionalFile>
            <AdditionalFile owner="root" group="root" permission="0644" target="/usr/share/pixmaps/wpcom.png">wpcom.png</AdditionalFile>
        </AdditionalFiles>
    </Package>

